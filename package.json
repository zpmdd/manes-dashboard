{
  "name": "manes-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-project.mjs base",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/dashboard-config.test.mjs tests/widget-data.test.mjs tests/data-sources.test.mjs tests/template-library.test.mjs tests/layout.test.mjs tests/editor-events.test.mjs tests/professional-charts.test.mjs tests/roadmap.test.mjs tests/themes.test.mjs tests/projects.test.mjs tests/vehicle-clustering.test.mjs tests/restrictions.test.mjs tests/restriction-workbook.test.mjs tests/restriction-store.test.mjs && node scripts/check-map.mjs",
    "dev:base": "vite --mode base",
    "dev:daoyan": "vite --mode daoyan",
    "build:base": "node scripts/build-project.mjs base",
    "build:daoyan": "node scripts/build-project.mjs daoyan",
    "build:all": "npm run build:base && npm run build:daoyan",
    "test:projects": "node --test tests/projects.test.mjs",
    "test:artifacts": "node scripts/check-project-builds.mjs",
    "test:browser": "node scripts/check-project-browser.mjs",
    "verify": "npm run check && npm test && npm run build:all && npm run test:sites && npm run test:artifacts && npm run test:sync",
    "test:algorithm": "node --test tests/vehicle-clustering.test.mjs",
    "test:restriction": "node --test tests/restrictions.test.mjs tests/restriction-workbook.test.mjs tests/restriction-store.test.mjs",
    "cluster:vehicles": "node scripts/cluster-vehicles.mjs",
    "sync:status": "python3 scripts/svn-sync.py status",
    "sync:bootstrap": "python3 scripts/svn-sync.py bootstrap",
    "sync:pull": "python3 scripts/svn-sync.py pull",
    "sync:push": "python3 scripts/svn-sync.py push",
    "sync:cancel": "python3 scripts/svn-sync.py cancel",
    "test:sync": "python3 -m unittest discover -s tests -p test_svn_sync.py"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@vitejs/plugin-react": "5.0.4",
    "echarts": "6.1.0",
    "exceljs": "^4.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.0",
    "vite": "6.4.2"
  }
}
